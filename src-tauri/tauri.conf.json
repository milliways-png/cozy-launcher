{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cozy-launcher",
  "version": "0.1.0",
  "identifier": "com.tomato.cozylauncher",
  "build": {
    "frontendDist": "../dist/cozy-launcher/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "cozy launcher",
        "width": 384,
        "height": 288,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
